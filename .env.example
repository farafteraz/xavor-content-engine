# Copy to .env (gitignored) or export as env vars. Never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...
# Needed while Xavor-Sentinel is private (Stage 0 reads its digests/ dir).
# Locally you can skip this and use: SENTINEL_TOKEN="$(gh auth token)" python run.py
SENTINEL_TOKEN=ghp_...
# Optional overrides:
# CONTENT_MODEL=claude-opus-4-8
# SENTINEL_REPO=farafteraz/Xavor-Sentinel

# Required only for --profile hybrid:
# OPENAI_API_KEY=your-key
# STRATEGY_MODEL=gpt-5.6-sol
# DRAFTING_MODEL=claude-opus-4-8
# EDITOR_MODEL=gpt-5.6-sol
# STRATEGY_REASONING_EFFORT=medium
